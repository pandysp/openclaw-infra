# First-time setup only: install -m 600 .env.example .env, then fill secrets.
# Keep an existing working .env; do not overwrite it with this template.
# .envrc clears inherited credentials and loads .env through dotenv.
# Use: direnv allow && direnv exec . <command>
# Never commit .env. Production PATs remain in encrypted pulumi/Pulumi.prod.yaml.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PULUMI_CONFIG_PASSPHRASE=
PULUMI_BACKEND_URL='s3://<bucket>?endpoint=https://<account-id>.r2.cloudflarestorage.com&region=auto'

# Needed only for local Phoenix repository/deploy-key permission checks.
# CI already uses its own STAGING_GITHUB_TOKEN Actions secret.
STAGING_GITHUB_TOKEN=
