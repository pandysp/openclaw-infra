// Tailscale policy for the DEDICATED Phoenix staging tailnet.
//
// Phoenix servers live for one hour, run an autonomous agent with real API
// credentials, and are publicly backed up. They join their own tailnet so
// that reaching the operator's devices or production is impossible by
// construction, not policed by an ACL. This policy is the whole tailnet:
// a CI runner (tag:ci), throwaway servers (tag:server), and the admin.
//
// Apply by pasting into https://login.tailscale.com/admin/acls of the
// staging tailnet. The "tests" block makes the editor reject a paste that
// would widen or break access.
{
	"tagOwners": {
		"tag:ci":     ["autogroup:admin"],
		"tag:server": ["autogroup:admin"],
	},

	"acls": [
		// The runner provisions over Tailscale SSH and smoke-tests the gateway
		// through Tailscale Serve. Nothing else.
		{"action": "accept", "src": ["tag:ci"], "dst": ["tag:server:22,443"]},
		// The admin may inspect a staging server while a run is paused.
		{"action": "accept", "src": ["autogroup:admin"], "dst": ["tag:server:*"]},
	],

	"ssh": [
		{"action": "accept", "src": ["tag:ci"], "dst": ["tag:server"], "users": ["ubuntu"]},
		{"action": "accept", "src": ["autogroup:admin"], "dst": ["tag:server"], "users": ["ubuntu"]},
	],

	"tests": [
		{"src": "tag:ci", "accept": ["tag:server:22", "tag:server:443"], "deny": ["tag:server:18789"]},
		// Servers never initiate towards the runner or each other.
		{"src": "tag:server", "deny": ["tag:ci:22", "tag:ci:443", "tag:server:22", "tag:server:443"]},
	],
	"sshTests": [
		{"src": "tag:ci", "dst": ["tag:server"], "accept": ["ubuntu"], "deny": ["root"]},
		{"src": "tag:server", "dst": ["tag:ci"], "deny": ["ubuntu", "root", "runner"]},
	],
}
