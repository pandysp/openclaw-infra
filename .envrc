unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN PULUMI_CONFIG_PASSPHRASE PULUMI_BACKEND_URL STAGING_GITHUB_TOKEN
strict_env
watch_file .env
# Check the parser directly: dotenv's eval masks errors and can print secrets.
if ! dotenv_exports=$(direnv dotenv bash .env 2>/dev/null); then
  log_error "Cannot load project .env; check file, permissions and syntax."
  exit 1
fi
# Fail on any rejected export, without printing its secret-bearing assignment.
eval "$dotenv_exports" 2>/dev/null
unset dotenv_exports
env_vars_required AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY PULUMI_CONFIG_PASSPHRASE PULUMI_BACKEND_URL
