# Dependencies
node_modules/

# Pulumi
.pulumi/
Pulumi.*.yaml.bak
# Stack config files contain encrypted secrets - never commit
# Use Pulumi.prod.yaml.template as reference
pulumi/Pulumi.prod.yaml
pulumi/Pulumi.dev.yaml
pulumi/Pulumi.staging.yaml

# Environment files (NEVER commit secrets)
.env
.env.*
!.env.template
!.env.example
docker/.env

# TypeScript
*.js
*.js.map
*.d.ts
!pulumi/*.ts

# Python
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Temporary
tmp/
temp/

# Ralph (AI agent runtime logs and run artifacts)
.ralph/

# Backups (contain secrets and session data)
backups/

# Ansible
ansible/*.retry
ansible/group_vars/openclaw.yml

# Dolt database files (added by bd init)
.dolt/
*.db
