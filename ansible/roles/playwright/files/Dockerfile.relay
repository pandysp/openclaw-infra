# The only way out of the Playwright browser networks: socat forwards each
# connection to one fixed address, the home proxy (see the relay unit).
FROM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
RUN apt-get update \
    && apt-get install -y --no-install-recommends socat \
    && rm -rf /var/lib/apt/lists/*
USER nobody
ENTRYPOINT ["socat"]
