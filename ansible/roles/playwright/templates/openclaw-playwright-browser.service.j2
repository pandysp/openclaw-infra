[Unit]
Description=Playwright browser MCP server ({{ item.agent_id }})
# Stops and restarts with the relay, the browser's only way out.
Requires=openclaw-playwright-relay.service
After=openclaw-playwright-relay.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f openclaw-playwright-browser-{{ item.agent_id }}
# --isolated keeps the profile in memory: no cookies or logins survive a restart.
# --allowed-hosts accepts only the adapter's own Host header, so a page cannot
# drive this server through localhost.
# --image-responses omit: the MCP adapter joins every result into one text part,
# so a screenshot would arrive as base64 text. Agents read pages as snapshots.
ExecStart=/usr/bin/docker run --rm --name openclaw-playwright-browser-{{ item.agent_id }} \
    --network {{ item.network }} --ip {{ item.browser_ip }} \
    --cap-drop ALL --security-opt no-new-privileges \
    --memory {{ openclaw_playwright_memory }} --shm-size 256m --pids-limit 1024 \
    {{ openclaw_playwright_image }} \
    --headless --browser chromium --no-sandbox --isolated --image-responses omit \
    --host 0.0.0.0 --port 8931 --allowed-hosts {{ item.browser_ip }}:8931 \
    --proxy-server http://{{ item.relay_ip }}:3128
ExecStop=/usr/bin/docker stop -t 5 openclaw-playwright-browser-{{ item.agent_id }}
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
