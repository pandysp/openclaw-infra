#!/usr/bin/env node
// MCP Auth Proxy — injects per-agent GitHub tokens into git traffic, so sandbox
// containers can clone and push without holding a token.
//
// Routes:
//   /health         → health check
//   /github-<id>/*  → github.com (per-agent PAT injection for git clone/push)
//   /openclaw/mcp   → authenticated OpenClaw loopback MCP (when configured)
//
// Zero npm dependencies. Listens on the codex-proxy-net gateway IP; ufw admits
// the default sandbox bridge and, when provisioned, the dedicated CLI bridge. Each
// workspace's .git-proxy-config rewrites github.com URLs to its /github-<id>/ route.
//
// Managed by Ansible — do not edit on the server.

'use strict';

const http = require('http');
const https = require('https');
const fs = require('fs');
const path = require('path');
const { pipeline } = require('stream');

const LISTEN_HOST = process.env.CODEX_PROXY_LISTEN || '127.0.0.1';
const LISTEN_PORT = parseInt(process.env.CODEX_PROXY_PORT || '{{ openclaw_mcp_adapter.codex_proxy_port }}', 10);
const CONNECT_TIMEOUT_MS = 10000;
const RESPONSE_TIMEOUT_MS = 30000;

// --- Structured logging ---

function log(level, msg, extra) {
  const entry = { ts: new Date().toISOString(), level, msg };
  if (extra) Object.assign(entry, extra);
  process.stdout.write(JSON.stringify(entry) + '\n');
}

// --- GitHub token management (per-agent PATs from directory) ---

const GITHUB_TOKENS_DIR = process.env.GITHUB_TOKENS_DIR || '/home/ubuntu/.openclaw/github-tokens';
const GITHUB_OVERALL_TIMEOUT_MS = 600000; // 10 min for large git pushes
const githubTokenCache = new Map(); // agent-id → { token, mtime }

// Returns null only when the agent has no token. Read failures throw, so a
// broken token store is never reported as an unknown agent.
function getGitHubToken(agentId) {
  const filePath = path.join(GITHUB_TOKENS_DIR, agentId);
  try {
    const stat = fs.statSync(filePath);
    const cached = githubTokenCache.get(agentId);
    if (cached && stat.mtimeMs === cached.mtime) return cached.token;
    const token = fs.readFileSync(filePath, 'utf8').trim();
    if (!token) return null;
    githubTokenCache.set(agentId, { token, mtime: stat.mtimeMs });
    log('info', 'Loaded GitHub token', { agent: agentId });
    return token;
  } catch (err) {
    if (err.code === 'ENOENT') return null;
    log('error', 'Failed to read GitHub token', { agent: agentId, code: err.code || 'unknown' });
    throw err;
  }
}

// A missing directory means no PATs are configured; other errors throw.
function getGitHubAgents() {
  try {
    return fs.readdirSync(GITHUB_TOKENS_DIR).filter(f => !f.startsWith('.'));
  } catch (err) {
    if (err.code === 'ENOENT') return [];
    log('error', 'Cannot read GitHub tokens directory', { code: err.code || 'unknown' });
    throw err;
  }
}

// Watch for token rotation
try {
  fs.watch(GITHUB_TOKENS_DIR, (_, filename) => {
    if (filename) {
      log('info', 'GitHub token file changed, invalidating cache', { agent: filename });
      githubTokenCache.delete(filename);
    }
  });
  log('info', 'Watching GitHub tokens directory for changes');
} catch (err) {
  if (err.code !== 'ENOENT') log('warn', 'Cannot watch GitHub tokens directory', { error: err.message });
}

// --- GitHub proxy (streaming, per-agent PAT injection) ---

function proxyGitHubRequest(clientReq, clientRes) {
  // Parse /github-<agent-id>/owner/repo.git/... from URL
  const match = clientReq.url.match(/^\/github-([^/]+)(\/.*)?$/);
  if (!match) {
    clientRes.writeHead(400, { 'Content-Type': 'application/json' });
    clientRes.end(JSON.stringify({ error: 'bad_request', detail: 'Invalid GitHub proxy URL format' }));
    return;
  }

  const agentId = match[1];
  const upstreamPath = match[2] || '/';
  // Dot names are the token directory itself, its parent or hidden files.
  if (agentId.startsWith('.')) {
    clientRes.writeHead(400, { 'Content-Type': 'application/json' });
    clientRes.end(JSON.stringify({ error: 'bad_request', detail: 'Invalid agent id' }));
    return;
  }
  let token;
  try {
    token = getGitHubToken(agentId);
  } catch {
    clientRes.writeHead(500, { 'Content-Type': 'application/json' });
    clientRes.end(JSON.stringify({ error: 'token_unavailable', detail: 'GitHub token could not be read' }));
    return;
  }
  if (!token) {
    clientRes.writeHead(404, { 'Content-Type': 'application/json' });
    clientRes.end(JSON.stringify({ error: 'no_token', detail: `No GitHub token for agent '${agentId}'` }));
    return;
  }

  const headers = Object.assign({}, clientReq.headers);
  delete headers.host;
  delete headers.authorization;
  headers.host = 'github.com';
  // GitHub git smart HTTP requires Basic auth (not Bearer)
  headers.authorization = 'Basic ' + Buffer.from('x-access-token:' + token).toString('base64');

  const options = {
    hostname: 'github.com',
    port: 443,
    path: upstreamPath,
    method: clientReq.method,
    headers: headers,
    timeout: CONNECT_TIMEOUT_MS,
  };

  const upReq = https.request(options, (upRes) => {
    clientRes.writeHead(upRes.statusCode, upRes.headers);
    pipeline(upRes, clientRes, (err) => {
      if (err && err.code !== 'ERR_STREAM_PREMATURE_CLOSE')
        log('error', 'GitHub stream error', { error: err.message, agent: agentId });
    });
  });

  upReq.on('timeout', () => upReq.destroy(new Error('GitHub connect timeout')));
  upReq.on('socket', (socket) => {
    const connected = () => upReq.setTimeout(RESPONSE_TIMEOUT_MS, () =>
      upReq.destroy(new Error('GitHub response timeout')));
    if (socket.connecting) socket.once('connect', connected);
    else connected();
  });
  upReq.on('error', (err) => {
    log('error', 'GitHub upstream error', { error: err.message, path: upstreamPath, agent: agentId });
    if (!clientRes.headersSent) {
      clientRes.writeHead(502, { 'Content-Type': 'application/json' });
      clientRes.end(JSON.stringify({ error: 'upstream_error', detail: err.message }));
    } else {
      clientRes.destroy();
    }
    clientReq.destroy();
  });

  // Stream request body (git packfiles can be huge — do NOT buffer)
  clientReq.on('error', (err) => {
    log('error', 'GitHub client request error', { error: err.message, agent: agentId });
    upReq.destroy();
  });
  clientReq.pipe(upReq);

  const overallTimer = setTimeout(() => {
    upReq.destroy(new Error('GitHub overall timeout'));
    clientReq.destroy();
  }, GITHUB_OVERALL_TIMEOUT_MS);
  clientRes.on('close', () => clearTimeout(overallTimer));
}

// --- OpenClaw MCP relay (fixed path, host-controlled target, unchanged auth) ---

const OPENCLAW_MCP_TARGET = process.env.OPENCLAW_CLI_MCP_TARGET;

function proxyOpenClawRequest(clientReq, clientRes) {
  let port;
  try {
    const target = JSON.parse(fs.readFileSync(OPENCLAW_MCP_TARGET, 'utf8'));
    port = target.port;
    if (Object.keys(target).length !== 1 || !Number.isInteger(port) || port < 1 || port > 65535)
      throw new Error('Invalid MCP target');
  } catch (err) {
    log('error', 'OpenClaw MCP target unavailable', { code: err.code || 'invalid_target' });
    clientRes.writeHead(err.code === 'ENOENT' ? 503 : 500, { 'Content-Type': 'application/json' });
    clientRes.end(JSON.stringify({ error: 'mcp_target_unavailable' }));
    return;
  }

  const headers = Object.assign({}, clientReq.headers, { host: `127.0.0.1:${port}` });
  const upReq = http.request({
    hostname: '127.0.0.1', port, path: '/mcp', method: clientReq.method,
    headers, timeout: CONNECT_TIMEOUT_MS,
  }, (upRes) => {
    clientRes.writeHead(upRes.statusCode, upRes.headers);
    pipeline(upRes, clientRes, (err) => {
      if (err && err.code !== 'ERR_STREAM_PREMATURE_CLOSE')
        log('error', 'OpenClaw MCP stream error', { code: err.code });
    });
  });
  upReq.on('socket', (socket) => {
    if (socket.connecting) socket.once('connect', () => upReq.setTimeout(0));
    else upReq.setTimeout(0);
  });
  upReq.on('timeout', () => upReq.destroy(new Error('MCP connect timeout')));
  upReq.on('error', (err) => {
    log('error', 'OpenClaw MCP upstream error', { code: err.code || 'upstream_error' });
    if (!clientRes.headersSent) {
      clientRes.writeHead(502, { 'Content-Type': 'application/json' });
      clientRes.end(JSON.stringify({ error: 'mcp_upstream_unavailable' }));
    } else {
      clientRes.destroy();
    }
  });
  clientReq.on('error', () => upReq.destroy());
  clientReq.on('aborted', () => upReq.destroy());
  clientRes.on('close', () => upReq.destroy());
  clientReq.pipe(upReq);
}

// --- HTTP server ---

const server = http.createServer((req, res) => {
  if (req.url === '/health' && req.method === 'GET') {
    let githubAgents = [];
    let readable = true;
    try {
      githubAgents = getGitHubAgents();
    } catch {
      readable = false;
    }
    const hasTokens = githubAgents.length > 0;
    const healthy = readable && (hasTokens || Boolean(OPENCLAW_MCP_TARGET));
    res.writeHead(healthy ? 200 : 503, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({
      status: healthy ? 'healthy' : 'unhealthy',
      github: { agents: githubAgents, hasTokens, readable },
      mcp: { configured: Boolean(OPENCLAW_MCP_TARGET) },
    }));
    return;
  }

  if (OPENCLAW_MCP_TARGET && req.url === '/openclaw/mcp'
      && ['GET', 'POST', 'DELETE'].includes(req.method)) {
    proxyOpenClawRequest(req, res);
    return;
  }

  // GitHub route — per-agent PAT injection for git clone/push (streaming, no body buffering)
  if (req.url.match(/^\/github-[^/]+/)) {
    proxyGitHubRequest(req, res);
    return;
  }

  res.writeHead(404, { 'Content-Type': 'application/json' });
  res.end(JSON.stringify({ error: 'not_found', detail: 'Only /health, /github-<agent>/ and configured /openclaw/mcp are served' }));

});

server.listen(LISTEN_PORT, LISTEN_HOST, () => {
  log('info', 'MCP auth proxy started', { host: LISTEN_HOST, port: LISTEN_PORT });
});

server.on('error', (err) => {
  log('error', 'Server error', { error: err.message });
  process.exit(1);
});

// Graceful shutdown
process.on('SIGTERM', () => {
  log('info', 'SIGTERM received, shutting down');
  server.close(() => process.exit(0));
  setTimeout(() => process.exit(1), 5000);
});
process.on('SIGINT', () => {
  log('info', 'SIGINT received, shutting down');
  server.close(() => process.exit(0));
  setTimeout(() => process.exit(1), 5000);
});
