---
# Deployment-specific overrides (copy to openclaw.yml, which is gitignored).
# Values here take precedence over all.yml because the "openclaw" group
# is more specific than the "all" group in Ansible's variable precedence.
#
# Usage:
#   cp ansible/group_vars/openclaw.yml.example ansible/group_vars/openclaw.yml
#   # Edit openclaw.yml with your deployment-specific settings
#   ./scripts/provision.sh

# Enable remote Mac node exec (see docs/SECURITY.md §5 for risks)
# node_exec_enabled: true

# Allow sandboxed agents to control browser on the host (native browser tool with target="host")
# openclaw_browser_allow_host_control: true

# Show error replies in Telegram (default true = errors silently swallowed)
# openclaw_telegram_silent_error_replies: false

# --- Heartbeat quiet hours (optional) ---
# Suppress heartbeats outside a time window (uses openclaw_timezone).
# Omit entirely to allow heartbeats 24/7.
#
# openclaw_heartbeat_active_hours:
#   start: "07:00"
#   end: "24:00"

# --- Multi-agent setup (uncomment and customize) ---
# By default, all.yml defines a single "main" agent. Adding agents here automatically
# generates per-agent MCP servers, workspaces, and token mappings (via playbook.yml
# pre_tasks). You only need to define agents — everything else derives from them.
#
# Prerequisites for each additional agent:
#   1. Add Pulumi secrets: telegramUserId, workspaceRepoUrl, githubToken (per-agent)
#   2. Wire them through scripts/provision.sh
#   3. Run: ./scripts/provision.sh
#
# openclaw_agents:
#   - id: "main"
#     is_default: true
#     deliver_to: "{{ telegram_user_id | default('') }}"
#     deliver_type: "dm"
#     deliver_channel: "telegram"      # telegram (default), whatsapp, or discord
#     heartbeat_every: "15m"
#     heartbeat_model: "anthropic/claude-opus-4-6"  # override default Sonnet
#     sandbox_mode: "off"  # override default sandbox mode (also sets exec.host=gateway)
#   - id: "second-agent"
#     is_default: false
#     deliver_to: "{{ telegram_second_user_id | default('') }}"
#     deliver_type: "dm"
#     deliver_channel: "telegram"
#     heartbeat_every: "1h"
#   - id: "whatsapp-agent"
#     is_default: false
#     deliver_to: "{{ whatsapp_phone | default('') }}"  # E.164 format: +491234567890
#     deliver_type: "dm"
#     deliver_channel: "whatsapp"
#     heartbeat_every: "1h"
#   - id: "group-agent"
#     is_default: false
#     deliver_to: "{{ telegram_group_agent_group_id | default('') }}"
#     deliver_type: "group"
#     deliver_channel: "telegram"
#     heartbeat_every: "4h"
#     group_allow_from:           # explicit allowlist (overrides default all-DM-agents list)
#       - 123456789               # user ID 1
#       - 987654321               # user ID 2
#     group_require_mention: true # require @-mention in group (default: false)

# --- Discord (Option A: single agent, multi-channel sessions) ---
# Discord channels get isolated sessions automatically. Configure at channel level:
#   pulumi config set discordBotToken --secret
#   pulumi config set discordGuildId "YOUR_GUILD_ID"
#   pulumi config set discordUserId "YOUR_USER_ID"
#   ./scripts/provision.sh --tags discord
# To deliver cron/heartbeat via Discord instead of Telegram, override main agent:
#   - id: "main"
#     is_default: true
#     deliver_to: "YOUR_DISCORD_USER_ID"
#     deliver_type: "dm"
#     deliver_channel: "discord"
#     heartbeat_every: "15m"

# --- Cron jobs (override to customize schedules per agent) ---
# all.yml provides generic main-agent defaults (daily standup + night shift).
# Override here for custom prompts, additional agents, or personal schedules.
#
# openclaw_cron_jobs:
#   - name: "main: Daily Standup"
#     agent: "main"
#     schedule: "30 9 * * *"
#     message: "Good morning! Summarize what needs attention today."
#   - name: "main: Night Shift"
#     agent: "main"
#     schedule: "0 23 * * *"
#     message: "Night shift. Review notes, organize, triage tasks."
#   - name: "second-agent: Daily Standup"
#     agent: "second-agent"
#     schedule: "0 10 * * *"
#     message: "Good morning! Summarize what needs attention today."

# --- Obsidian Headless Sync (optional) ---
# Run obsidian-headless daemons to sync workspaces to Obsidian Sync cloud.
# Requires an Obsidian Sync subscription and secrets via provision.sh:
#   pulumi config set obsidianAuthToken --secret <token>        # from ~/.obsidian-headless/auth_token
#   pulumi config set obsidianVaultPassword --secret <password>  # E2E encryption password
#
# obsidian_headless_enabled: true
# obsidian_headless_agents:
#   - "main"
# # Override excluded folders (default: .git,.venv,node_modules,.cache,.env)
# obsidian_headless_excluded_folders: ".git,.venv,node_modules,.cache,.env,.claude"

# --- Mac local daemons (scripts/deploy-mac-daemons.sh) ---
# NOT ON A MAC? SKIP THIS WHOLE BLOCK. It configures the macOS LaunchDaemon
# deployer + prep scripts (scripts/*mac*.sh) and nothing else — the Linux/systemd
# VPS never reads it. Everything Mac-shaped is nested under the single `mac:` key
# so it stays one skippable block no matter how many knobs get added later.
#
# Path & toolchain tunables (workspace dir, Node pin, GitHub org, qmd binary) are
# NOT here — they live in scripts/lib/mac-config.sh as env-overridable defaults.
# This block is per-deployment POLICY only.
#
# All three sub-keys are optional and fail permissive: omit one, or the whole
# `mac:` block, and nothing is restricted. A broken or empty config can never
# silently tear the fleet down.
#
# mac:
#   # agents — which agents get daemons ON THIS MAC. Absent or empty ⇒ every
#   # agent in openclaw_agents. Use it when the VPS runs the full roster but the
#   # Mac should only carry a few (each agent costs ~3 resident processes per
#   # account). Agents dropped from this list are booted out + removed on the
#   # next full deploy; an explicit `deploy-mac-daemons.sh <agent>` still
#   # overrides it for a one-off run and reconciles nothing.
#   #
#   # NOTE the deliberate asymmetry with obsidian_headless_agents above, which
#   # means "nobody" when empty: that key opts INTO an optional feature, whereas
#   # this one RESTRICTS an already-running set, so the safe default is inverted.
#   agents:
#     - main
#     - tl
#
#   # daemons — which of the four per-agent services to run. A service is enabled
#   # unless set false (omit a service, or the block, to keep it enabled). The
#   # deployer reconciles: a service set false is booted out + removed next run.
#   daemons:
#     git-sync: true
#     obsidian-headless: true
#     qmd-watch: true
#     qmd-http: false        # e.g. disable the qmd MCP HTTP server if nothing consumes it
#
#   # accounts — account order for qmd-http port bases. Effective port =
#   # QMD_HTTP_BASE_PORT + (index in this list)*100 + agentPosition. List every
#   # macOS account running these daemons so ports never collide. Only relevant
#   # when qmd-http is enabled on more than one account; OPENCLAW_ACCOUNT_INDEX
#   # overrides per run, and an unlisted account falls back to index 0.
#   accounts:
#     - spannagel
#     - tl
#     - andreasspannagel
#
# DEPRECATED: the pre-nesting flat keys `mac_daemons:` and `mac_accounts:` are
# still honoured (they map to mac.daemons / mac.accounts) so existing forks keep
# working, but the deployer prints a migration note. There is no flat equivalent
# of mac.agents — nest the block to use it.

# --- Claude Code plugins (optional) ---
# Plugins installed into the VPS agents' `claude` CLI. This is a per-deployment
# choice and is NOT defaulted in all.yml — define it here to enable it. Each
# entry is a plugin name (resolved from any added marketplace) or
# "<plugin>@<marketplace-owner>" to pin it to a specific marketplace. Keep this
# in sync with the marketplaces — a plugin that no longer exists in its
# marketplace fails provisioning.
#
# claude_code_plugins:
#   config_dir: "/home/ubuntu/.openclaw/claude-code-plugins"
#   marketplaces:
#     - repo: "anthropics/claude-plugins-official"
#     - repo: "astral-sh/claude-code-plugins"
#   plugins:
#     - "code-review"
#     - "feature-dev"
#     - "astral@astral-sh"

# --- Advanced: manual overrides for auto-generated config ---
# The following variables are normally auto-generated from openclaw_agents.
# Define them here ONLY if you need non-standard naming or custom server configurations.
#
# openclaw_mcp_servers:       # Override auto-generated MCP server list
# openclaw_workspaces:        # Override auto-generated workspace list
